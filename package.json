{
  "name": "parkey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @parkey/mobile start",
    "dev:web": "pnpm --filter @parkey/web dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "pnpm --filter @parkey/web build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test": "node --test apps/mobile/src/discovery/*.test.mjs apps/web/src/demo/workspace.test.mjs && python3 scripts/test-osm-extract.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
