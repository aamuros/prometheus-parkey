{
  "expo": {
    "name": "Parkey",
    "slug": "parkey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parkey",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkey.discovery"
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.parkey.discovery"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Parkey uses your location to find and show nearby parking. You can also search without sharing your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an optional photo of parking signs for your local report preview.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
