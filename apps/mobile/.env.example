# Optional planned integrations; the starter runs without these values.
# EXPO_PUBLIC_ values are embedded in the app and are NOT secrets.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_PAYMONGO_PUBLIC_KEY=

# Android emulator: use http://10.0.2.2:54321 for the local Supabase URL.
# Physical device: use your development machine's reachable LAN IP.
# Restrict future Maps keys by app identity and permitted APIs.
