# Optional planned integrations; the starter runs without these values.
# VITE_ values are embedded in browser code and are NOT secrets.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_PAYMONGO_PUBLIC_KEY=

# Restrict future Maps keys by HTTP referrer and permitted APIs.
# Never put Supabase secret/service-role or payment secret keys here.
